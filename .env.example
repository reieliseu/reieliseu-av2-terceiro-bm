# Neon PostgreSQL connection string. Configure locally and in the backend hosting environment.
DATABASE_URL=

# Generate a random secret with at least 32 characters for JWT signing.
JWT_SECRET=

# Express API
PORT=4000
# Render production: FRONTEND_URL=https://startnet.app.br
FRONTEND_URL=http://localhost:3000
# Additional exact origins, separated by commas; no paths or wildcard.
ALLOWED_ORIGINS=

# React frontend. Local development URL below; for production use:
# NEXT_PUBLIC_API_URL=https://reieliseu-av2-terceiro-bm.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
